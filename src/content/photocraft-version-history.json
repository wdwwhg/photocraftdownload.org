      "releaseUrl": "https://github.com/storytold/photocraft/releases/tag/v0.8.2",
      "compareUrl": "https://github.com/storytold/photocraft/compare/v0.7.0...v0.8.2",
      "summary": {
        "en": "Less UI interruption at the end of brush strokes and during saving; improved PSD reading.",
        "zh": "减少画笔抬笔和保存时的界面停顿，并改进 PSD 读取。"
      },
      "changes": [
        {
          "en": "Avoid the freeze previously seen when finishing a brush stroke.",
          "zh": "处理结束一笔绘画时出现的卡顿。",
          "source": "https://github.com/storytold/photocraft/pull/2131"
        },
        {
          "en": "Run save encoding in the background, reducing work on the interactive interface.",
          "zh": "把保存时的耗时编码移到后台，减少占用操作界面。",
          "source": "https://github.com/storytold/photocraft/pull/2517"
        },
        {
          "en": "Improve PSD interoperability and decoding.",
          "zh": "改进 PSD 解码与文件互通。",
          "source": "https://github.com/storytold/photocraft/pull/1955"
        }
      ],
      "downloads": [
        {
